<?xml version="1.0" encoding="utf-8"?>
<!-- Top-bar style of the pill: the same views (same ids) as floating_pill.xml laid out as two
     short rows across the screen. Row 1: controls + what was scanned. Row 2: the answers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pillRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/pill_background"
    android:paddingStart="5dp"
    android:paddingEnd="5dp"
    android:paddingTop="4dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/pillScanBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="62dp"
            android:text="SCAN"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/scan_btn_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/pillAutoBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="44dp"
            android:text="AUTO"
            android:textColor="@color/slate_text"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/expand_btn_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/pillModeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STANDBY"
            android:textColor="@color/slate_text"
            android:textSize="8sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/badge_bg"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:layout_marginStart="5dp" />

        <!-- Pokémon · CP on one line; takes whatever room is left -->
        <TextView
            android:id="@+id/pillTargetLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="6dp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/pillGoneBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GONE ✓"
            android:textColor="@color/red_delete"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/expand_btn_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginStart="4dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/pillExpandBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OPEN"
            android:textColor="@color/cyan_accent"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/expand_btn_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/pillCloseBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLOSE"
            android:textColor="@color/red_delete"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/expand_btn_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Answers side by side (caption over value), added from pill_slot.xml at runtime -->
    <LinearLayout
        android:id="@+id/pillSlots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp" />

</LinearLayout>
